# ============================================================
# Konfigurasi DEGOFOOD Admin Panel (Production VPS)
# ============================================================

# URL backend. Jika admin panel satu server dengan backend:
BACKEND_URL=http://127.0.0.1:8000
# Jika backend di domain lain:
# BACKEND_URL=https://api.DEGOFOOD.example.com

# Kredensial login admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-kuat

# Harus sama dengan ADMIN_API_KEY di backend/.env
ADMIN_API_KEY=ganti-dengan-key-rahasia-panjang

# Secret untuk session (wajib diganti, minimal 32 karakter)
SESSION_SECRET=ganti-dengan-string-rahasia-minimal-32-karakter
