[Unit]
Description=DEGOFOOD Admin Panel
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/DEGOFOOD/admin_panel
Environment=PATH=/opt/DEGOFOOD/admin_panel/venv/bin
EnvironmentFile=/opt/DEGOFOOD/admin_panel/.env
ExecStart=/opt/DEGOFOOD/admin_panel/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
