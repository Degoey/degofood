# ============================================================
# Konfigurasi DEGOFOOD Backend (Production VPS)
# ============================================================

# URL SQLite. Untuk produksi, gunakan path absolut di luar repo, misal:
# DATABASE_URL=sqlite:///var/lib/DEGOFOOD/food_delivery.db
DATABASE_URL=sqlite:///./food_delivery.db

# API key untuk melindungi endpoint admin (opsional, tapi sangat direkomendasikan)
ADMIN_API_KEY=ganti-dengan-key-rahasia-panjang

# CORS origins. Gunakan '*' untuk development.
# Di production isi dengan domain frontend/admin, contoh:
# CORS_ORIGINS=https://admin.DEGOFOOD.example.com,https://DEGOFOOD.example.com
CORS_ORIGINS=*

# Secret untuk session admin panel (jika admin panel ingin menggunakannya)
SESSION_SECRET=ganti-dengan-string-rahasia-minimal-32-karakter
